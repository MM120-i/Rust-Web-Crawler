# Copy to .env and adjust if needed: cp .env.example .env

# Local PostgreSQL (see docker-compose.yml)
POSTGRES_USER=crawler
POSTGRES_PASSWORD=crawler_dev_password
POSTGRES_DB=crawler
POSTGRES_PORT=5432

# Connection string the crawler will use once the frontier (ADR-002) is implemented.
DATABASE_URL=postgres://crawler:crawler_dev_password@localhost:5432/crawler
